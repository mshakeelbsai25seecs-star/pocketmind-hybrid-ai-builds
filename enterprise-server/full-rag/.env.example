# NexusAI Full Server RAG — copy to .env and adjust

# Host paths (mounted into containers)
NEXUS_MODELS_HOST=/opt/nexusai/models
NEXUS_DATA_HOST=/opt/nexusai/data

# Shared secret for gateway Bearer auth (setup.sh generates one if empty)
NEXUSAI_SERVER_TOKEN=

# Bind addresses inside compose network
BIND=0.0.0.0:8080

# Service URLs (used by gateway; docker DNS names)
LLM_BASE_URL=http://llm:8000/v1
EMBED_CODE_URL=http://embed-code:8001/v1
EMBED_KNOWLEDGE_URL=http://embed-knowledge:8002/v1
NEXUS_RERANK_URL=http://rerank:8003

# Model filenames under NEXUS_MODELS_HOST
LLM_MODEL_PATH=/models/llm/Qwen2.5-7B-Instruct-Q4_K_M.gguf
CODE_EMBED_MODEL_PATH=/models/embeddings/Qwen3-Embedding-8B-Q4_K_M.gguf
KNOWLEDGE_EMBED_MODEL_PATH=/models/embeddings/bge-m3-Q4_K_M.gguf
RERANK_MODEL_PATH=/models/rerankers/Qwen3-Reranker-4B-Q4_K_M.gguf

# Hugging Face download URLs (override for mirrors / pinned revisions)
HF_LLM_URL=https://huggingface.co/Qwen/Qwen2.5-7B-Instruct-GGUF/resolve/main/qwen2.5-7b-instruct-q4_k_m.gguf
HF_CODE_EMBED_URL=https://huggingface.co/Qwen/Qwen3-Embedding-8B-GGUF/resolve/main/Qwen3-Embedding-8B-Q4_K_M.gguf
HF_KNOWLEDGE_EMBED_URL=https://huggingface.co/gpustack/bge-m3-GGUF/resolve/main/bge-m3-Q4_K_M.gguf
HF_RERANK_URL=https://huggingface.co/Qwen/Qwen3-Reranker-4B-GGUF/resolve/main/Qwen3-Reranker-4B-Q4_K_M.gguf

# Local download destinations (relative to NEXUS_MODELS_HOST)
LLM_LOCAL_NAME=llm/Qwen2.5-7B-Instruct-Q4_K_M.gguf
CODE_EMBED_LOCAL_NAME=embeddings/Qwen3-Embedding-8B-Q4_K_M.gguf
KNOWLEDGE_EMBED_LOCAL_NAME=embeddings/bge-m3-Q4_K_M.gguf
RERANK_LOCAL_NAME=rerankers/Qwen3-Reranker-4B-Q4_K_M.gguf

# llama.cpp runtime knobs
CTX_SIZE=8192
EMBED_CTX_SIZE=8192
GPU_LAYERS=-1
THREADS=8

# Published host ports
LLM_PORT=8000
CODE_EMBED_PORT=8001
KNOWLEDGE_EMBED_PORT=8002
RERANK_PORT=8003
GATEWAY_PORT=8080

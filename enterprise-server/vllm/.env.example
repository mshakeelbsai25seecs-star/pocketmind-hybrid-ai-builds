# Copy this file to .env and edit values before starting.

MODEL_ID=Qwen/Qwen2.5-7B-Instruct
SERVED_MODEL_NAME=nexusai-enterprise
TENSOR_PARALLEL_SIZE=1
PIPELINE_PARALLEL_SIZE=1
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
PORT=8000
HUGGING_FACE_HUB_TOKEN=

# Optional access token handled by reverse proxy or gateway.
# vLLM itself can be run behind Nginx for production authentication.
NEXUSAI_SERVER_TOKEN=change-this-token

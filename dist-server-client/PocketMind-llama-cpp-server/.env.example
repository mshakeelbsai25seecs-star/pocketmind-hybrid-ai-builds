# Chat model (Docker path). Must exist as ./models/<filename> on the host.
# Example: MODEL_PATH=/models/Phi-3-mini-4k-instruct-Q4_K_M.gguf
# Use start-admin.ps1 or start-server.ps1 — they refuse incomplete/corrupt GGUFs.
MODEL_PATH=/models/model.gguf
PORT=8000
CTX_SIZE=4096
# GPU offload: leave AUTO_OPTIMIZE=1 so Start picks max GPU layers automatically.
# Set AUTO_OPTIMIZE=0 and GPU_LAYERS=N to pin a fixed layer count.
AUTO_OPTIMIZE=1
GPU_LAYERS=-1
THREADS=8

# Knowledge Chat embedding services (docker-compose.embeddings.yml)
# One llama-server process per model; embeddings run separately from chat.
# Skip for chat-only / PocketCode hybrid tests.
CODE_EMBED_PORT=8001
KNOWLEDGE_EMBED_PORT=8002
CODE_EMBED_MODEL_PATH=/models/nomic-embed-text-v1.5.Q4_K_M.gguf
KNOWLEDGE_EMBED_MODEL_PATH=/models/bge-m3-Q4_K_M.gguf
EMBED_CTX_SIZE=2048
EMBED_GPU_LAYERS=-1

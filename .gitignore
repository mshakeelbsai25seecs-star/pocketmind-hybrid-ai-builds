dist-server-client/PocketMind-llama-cpp-server/PocketMind-llama-cpp-server/

# Python bytecode cache
__pycache__/
*.pyc

# Vendored Code Workspace tooling (keep MANIFEST.json + ci-keep for Tauri bundle)

!src-tauri/resources/tooling/MANIFEST.json
!src-tauri/resources/tooling/ci-keep/
!src-tauri/resources/tooling/ci-keep/**

# Bundled llama.cpp runtimes are staged at build time (too large for git)
src-tauri/resources/llama.cpp/**
!src-tauri/resources/llama.cpp/README.md
!src-tauri/resources/llama.cpp/ci-keep/
!src-tauri/resources/llama.cpp/ci-keep/**


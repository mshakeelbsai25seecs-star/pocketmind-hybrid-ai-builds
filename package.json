{
  "name": "nexus-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:macos": "bash scripts/tauri-dev-macos.sh",
    "tauri:dev:linux": "bash scripts/tauri-dev-linux.sh",
    "tauri:dev:low-mem": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tauri-dev-low-mem.ps1",
    "setup:macos-runtimes": "bash scripts/setup_macos_runtimes.sh",
    "verify:macos-runtimes": "bash scripts/verify_macos_runtimes.sh",
    "setup:windows-runtimes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install_llama_cpp_runtimes.ps1",
    "verify:windows-runtimes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_windows_runtimes.ps1",
    "fetch:tooling": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-tooling.ps1",
    "fetch:tooling:unix": "bash scripts/fetch-tooling.sh",
    "setup:linux-runtimes": "bash scripts/setup_linux_runtimes.sh",
    "verify:linux-runtimes": "bash scripts/verify_linux_runtimes.sh",
    "build:macos-x64-metal": "bash scripts/build_macos_x64_metal_runtime.sh",
    "build:macos-release": "bash scripts/build_macos_release.sh",
    "dist:stage:windows": "powershell -ExecutionPolicy Bypass -File distribution/windows-desktop/scripts/stage-release.ps1",
    "dist:stage:macos": "bash distribution/macos-desktop/scripts/stage-release.sh",
    "dist:stage:linux": "bash distribution/linux-desktop/scripts/stage-release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "diff": "^9.0.0",
    "framer-motion": "^10.16.0",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "diff": "^7.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@tauri-apps/cli": "^1.5.0",
    "@types/diff": "^7.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}

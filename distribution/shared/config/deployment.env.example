# NexusAI deployment environment variables
# Copy to machine env, service unit, or set before launching NexusAI.

# --- Windows example ---
NEXUS_DATA_ROOT=C:\ProgramData\NexusAI
NEXUS_MODELS_DIR=C:\ProgramData\NexusAI\models
NEXUS_SOC_DATA_ROOT=C:\ProgramData\NexusAI\company-data
NEXUS_EXPORT_DIR=C:\ProgramData\NexusAI\exports
NEXUS_EMBEDDING_MODEL=C:\ProgramData\NexusAI\models\embeddings\nomic-embed-text-v1.5.Q4_K_M.gguf

# --- Linux / macOS server example (uncomment and adjust) ---
# NEXUS_DATA_ROOT=/var/lib/nexusai
# NEXUS_MODELS_DIR=/var/lib/nexusai/models
# NEXUS_SOC_DATA_ROOT=/var/lib/nexusai/company-data
# NEXUS_EXPORT_DIR=/var/lib/nexusai/exports
# NEXUS_EMBEDDING_MODEL=/var/lib/nexusai/models/embeddings/nomic-embed-text-v1.5.Q4_K_M.gguf

# Performance
NEXUS_DEPLOY_MODE=server
NEXUS_CONTEXT_SIZE=8192
NEXUS_MAX_TOKENS=1024

# Extra allowed read paths (semicolon on Windows, colon on Unix)
# NEXUS_ALLOWED_PATHS=/mnt/legacy-soc;/data/share/soc

# Llama.cpp runtime (optional override)
# NEXUS_LLAMA_SERVER=/opt/nexusai/bin/llama.cpp/cpu/llama-server

# Optional: public Cloudflare R2 / CDN base for llama.cpp Windows runtime zips
# (manifest.json + versioned zip objects). Avoids GitHub release rate limits.
# Example: https://runtimes.example.com/llama.cpp
# NEXUS_LLAMA_RUNTIME_MIRROR=https://runtimes.example.com/llama.cpp
# POCKETMIND_LLAMA_RUNTIME_BASE_URL=https://runtimes.example.com/llama.cpp
